<!doctype html>
<html lang="pt-PT">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Administração | Jhonatas Moraes</title><link rel="stylesheet" href="/style.css">
</head>
<body class="admin-body">
  <main class="admin-shell login-shell">
    <a class="brand" href="/"><span class="brand-mark">JM</span><span>Jhonatas<span class="accent">.</span></span></a>
    <section class="admin-panel login-panel">
      <p class="eyebrow">ÁREA RESERVADA</p><h1>Entrar na administração</h1>
      <p class="admin-muted">Acede para gerir os projetos do teu portfólio.</p>
      <% if (error) { %><p class="alert error"><%= error %></p><% } %>
      <form method="post" action="/admin/login" class="admin-form">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <label>Utilizador<input name="username" autocomplete="username" required maxlength="100"></label>
        <label>Palavra-passe<input type="password" name="password" autocomplete="current-password" required></label>
        <button class="button primary admin-submit" type="submit">Entrar <span>→</span></button>
      </form>
      <a class="back-link" href="/">← Voltar ao portfólio</a>
    </section>
  </main>
</body>
</html>
